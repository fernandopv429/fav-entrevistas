# Banco de dados das entrevistas (Postgres)
DATABASE_URL=

# API de Petições
PETICOES_BASE_URL=https://peticoes.nexusdevhub.com
PETICOES_API_KEY=

# Chatwoot (preencher quando integrar)
CHATWOOT_BASE_URL=https://maneger.nexusdevhub.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
# token do robô 'atualiza base de dados' (id 2) — menor privilégio
# que o token pessoal: o Chatwoot restringe tokens de robô a uma lista branca

# Token pessoal (admin) — NÃO é usado pela API. Só para tarefas
# administrativas via curl (criar etiquetas, listar robôs), que o token de
# robô não pode fazer: /profile e /accounts/1/labels devolvem 401 para bots.
CHATWOOT_ADMIN_TOKEN=

# API de ingestão (consumida pelo agente de IA do Chatwoot)
INGESTAO_API_KEY=
INGESTAO_HOST=0.0.0.0
INGESTAO_PORT=8088

# Etiqueta que autoriza retomar uma entrevista já concluída
ETIQUETA_RETOMAR=retomar-entrevista

# Segredo do Webhook do robô (tela Robôs). Só é usado se o Chatwoot chamar
# POST /webhook/chatwoot deste serviço direto. Com o webhook apontando para o
# n8n, quem valida a assinatura é o n8n.
CHATWOOT_WEBHOOK_SECRET=

# n8n (API pública) — usada para ler/escrever workflows via curl
N8N_URL=https://n8n.nexusdevhub.com
N8N_API_KEY=

# Token do painel embutido no Chatwoot. Vai na URL do app (?t=...), porque
# iframe não manda cabeçalho. Quem tiver a URL vê os dados: trate como segredo.
PAINEL_TOKEN=
